{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoRA Trainer",
  "version": "0.1.0",
  "identifier": "com.filmclusive.charactercapture",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoRA Trainer",
        "width": 800,
        "height": 600,
        "minWidth": 520,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$DOCUMENT/Filmclusive LoRAs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "resources": [
      "resources/python-runtime",
      "../../runner",
      "../../presets",
      "../../vendor"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
